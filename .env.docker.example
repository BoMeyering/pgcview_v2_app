# Copy this file to .env.docker (same directory as docker-compose.yaml) and
# fill in the values, then run:
#   docker compose --env-file .env.docker up -d
#
# Deliberately NOT named .env — that name is docker compose's (and this repo's
# own settings/dev.py, via django-environ) implicit default, and it's also
# what the app's own .env.example (for local dev via `manage.py runserver`)
# gets copied to. Keeping this one as .env.docker means both can sit in the
# repo at once without one clobbering the other depending on what you're doing.

# ── Django ───────────────────────────────────────────────────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=pgcview.example.com
CSRF_TRUSTED_ORIGINS=https://pgcview.example.com

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=pgcview
POSTGRES_USER=pgcview
POSTGRES_PASSWORD=change-me
# Host port the db container's 5432 is published on (rarely needs changing).
POSTGRES_PORT=5432

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs: https://<your-domain>/accounts/google/login/callback/
GOOGLE_OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-client-secret

# Google API Key (for Google Drive Picker)
# Create a Browser API key in Google Cloud Console
# Enable: Google Picker API, Google Drive API
GOOGLE_API_KEY=your-api-key

# ── RunPod inference API ─────────────────────────────────────────────────
RUNPOD_BASE_URL=https://mm45wxdx8ku3z1.api.runpod.ai
RUNPOD_API_KEY=your-runpod-api-key

# ── Image / container tuning (all optional — sensible defaults apply) ────
# Which image:tag docker-compose.yaml's web service runs. build_container.sh
# builds both IMAGE_NAME:IMAGE_TAG and IMAGE_NAME:latest — point this at
# whichever you want running.
# IMAGE_NAME=pgcview
# IMAGE_TAG=latest
# WEB_PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
